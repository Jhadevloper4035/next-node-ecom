   <Row><Cell><Data ss:Type="Number">1</Data></Cell><Cell><Data ss:Type="String">Caden Retro Cream Sofa</Data></Cell><Cell><Data ss:Type="String">A retro-inspired cream sofa with clean lines and comfortable, modern cushioning.</Data></Cell><Cell><Data ss:Type="Number">42000</Data></Cell><Cell><Data ss:Type="Number">50000</Data></Cell><Cell><Data ss:Type="Number">100</Data></Cell><Cell><Data ss:Type="String">Sofas</Data></Cell><Cell><Data ss:Type="String">Sofa, Living Room</Data></Cell><Cell><Data ss:Type="String">Louis Vuitton</Data></Cell><Cell><Data ss:Type="String">Pink</Data></Cell><Cell><Data ss:Type="String">Living Room</Data></Cell><Cell><Data ss:Type="String">Retro</Data></Cell><Cell><Data ss:Type="String">3-seater, 2-seater, 4-seater</Data></Cell><Cell><Data ss:Type="String">Wood</Data></Cell><Cell><Data ss:Type="Number">4.5</Data></Cell><Cell><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String">Louis Vuitton, Hermes</Data></Cell><Cell><Data ss:Type="String">Pink, Orange</Data></Cell><Cell><Data ss:Type="String">S, M, L, XL</Data></Cell><Cell><Data ss:Type="String">true</Data></Cell><Cell><Data ss:Type="String">false</Data></Cell><Cell><Data ss:Type="String">https://rantechnology.in/curve-&amp;-comfort/final-products/sofa_A1.jpg</Data></Cell><Cell><Data ss:Type="String">https://rantechnology.in/curve-&amp;-comfort/final-products/sofa_A2.jpg</Data></Cell><Cell><Data ss:Type="String">https://rantechnology.in/curve-&amp;-comfort/final-products/sofa_A3.jpg</Data></Cell><Cell><Data ss:Type="String">https://rantechnology.in/curve-&amp;-comfort/final-products/sofa_A4.jpg</Data></Cell><Cell><Data ss:Type="String">https://rantechnology.in/curve-&amp;-comfort/final-products/sofa_A5.jpg</Data></Cell><Cell><Data ss:Type="String">https://rantechnology.in/curve-&amp;-comfort/final-products/sofa_A6.jpg</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">1-Year Limited Warranty: Covers manufacturing defects in frame/structure and hardware under normal indoor use. Excludes wear &amp; tear, accidental damage, stains, water/heat damage, misuse, commercial use, or unauthorized repairs.</Data></Cell><Cell><Data ss:Type="String">Keep away from direct sunlight and heat sources to reduce fading and warping., Use coasters/mats for hot or cold items to prevent rings and heat marks., Wipe spills immediately with a clean dry cloth; blot—do not rub aggressively., Dust regularly using a microfiber cloth; avoid abrasive scrubbers., Do not use harsh chemicals or bleach; test cleaners on a hidden area first., Lift furniture to move—do not drag; use felt pads under accessories and décor., For upholstery, vacuum weekly using a soft brush attachment and rotate cushions periodically (if removable).</Data></Cell></Row>
