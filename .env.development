# Development environment for Docker Compose (backend)
# Copy to .env.development and edit secrets as needed.

NODE_ENV=development
PORT=5000
APP_NAME=NextNodeEcom
API_PREFIX=/api/v1

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# MongoDB Atlas development database
MONGODB_URI=mongodb+srv://development:tP7jzweLL1y8XBol@curve-and-comfort.lvwb3ba.mongodb.net/ecomerce-development?appName=curve-and-comfort


REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace_with_very_long_random_string_access
JWT_REFRESH_SECRET=replace_with_very_long_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth

# Cashfree payment gateway (sandbox credentials)
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
CHECKOUT_EXPIRY_MINUTES=15

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
TRUST_PROXY="true"


# frontend .env.development
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
