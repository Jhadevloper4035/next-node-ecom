PORT=5000
APP_NAME=CurveComfort
API_PREFIX=/api/v1
NODE_ENV=production

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/curve_comfort
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_PREFIX=curve-comfort:v1
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_PRODUCT_LIST_TTL_SECONDS=60
CACHE_PRODUCT_TTL_SECONDS=300
CACHE_CATEGORY_TTL_SECONDS=600
CACHE_OPERATION_TIMEOUT_MS=100

FRONTEND_URL=https://example.com
CORS_ORIGIN=https://example.com,https://www.example.com
CORS_CREDENTIALS=true
TRUST_PROXY=true

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_NAME=refreshToken
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=example.com
COOKIE_PATH=/api/v1/auth

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Curve & Comfort <no-reply@example.com>
